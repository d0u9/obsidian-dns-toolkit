{
	"name": "obsidian-dns-toolkit",
	"version": "0.1.2",
	"description": "A modular toolkit for extending and refining Obsidian workflows.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/d0u9/obsidian-dns-toolkit.git"
	},
	"homepage": "https://github.com/d0u9/obsidian-dns-toolkit#readme",
	"bugs": {
		"url": "https://github.com/d0u9/obsidian-dns-toolkit/issues"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"markdown",
		"custom-containers"
	],
	"packageManager": "npm@11.17.0",
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
